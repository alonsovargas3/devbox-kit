# devbox-kit — one file per box. Copy to ~/.config/devbox/<box>.env (or run `devbox init <box>`).
# Pick a box with `devbox --box <box> ...`, DEVBOX_BOX=<box>, or ~/.config/devbox/default.
# Plain shell assignments: no spaces around '=', quote values that contain spaces.

# --- Required -------------------------------------------------------------------
DEVBOX_NAME="devbox-jdoe"             # unique per AWS account; names every resource (tag Name)
AWS_PROFILE="my-dev-profile"          # laptop AWS CLI profile that can provision (iam/provisioner-policy.json)
AWS_REGION="us-west-2"
AZ="us-west-2a"                       # the data volume is AZ-bound; the instance always launches here
OWNER_EMAIL="jdoe@example.com"        # tag `owner`
GIT_NAME="Jane Doe"                   # git identity on the box
GIT_EMAIL="jdoe@example.com"

# --- Machine ----------------------------------------------------------------------
INSTANCE_TYPE="m7i-flex.xlarge"       # 4 vCPU / 16 GB (~$0.19/hr in us-west-2). Resize later with `devbox resize`.
ARCH="amd64"                          # amd64 or arm64 (arm64 needs a Graviton INSTANCE_TYPE, e.g. m7g.xlarge)
DATA_GB="100"                         # persistent data volume: /home, Docker, containerd (grow online later)
ROOT_GB="40"                          # root volume: OS + tools; replaceable
IDLE_MIN="45"                         # auto-stop after this many minutes with no terminal use / new SSH / load

# --- Network & org constraints -----------------------------------------------------
SUBNET_ID=""                          # empty = the default VPC's subnet in $AZ. Must reach the internet
                                      # (public IP + IGW, or NAT) so SSM, apt, and GitHub work.
ASSOCIATE_PUBLIC_IP="yes"             # "no" if your subnet egresses through NAT (saves ~$3.60/mo)
INSTANCE_PROFILE=""                   # empty = create "<DEVBOX_NAME>-profile" (needs IAM create rights).
                                      # If your org blocks IAM creation, ask an admin for an instance profile
                                      # with AmazonSSMManagedInstanceCore and put its name here.
EBS_KMS_KEY=""                        # empty = account default EBS encryption key
EXTRA_TAGS=""                         # org tag policies, space-separated: "CostCenter=eng Team=platform"
SNAPSHOTS="on"                        # daily DLM snapshots of the data volume (needs the DLM default role)
SNAPSHOT_KEEP="7"
SNAPSHOT_TIME_UTC="23:00"

# --- Access -----------------------------------------------------------------------
SSH_HOST_ALIAS="devbox"               # `ssh devbox`; the Claude guard and docs use this alias
SSH_KEY_FILE="$HOME/.ssh/${DEVBOX_NAME}_ed25519"   # laptop → box key (SSH rides SSM; no open port)

# --- Logins on the box ------------------------------------------------------------
DEVBOX_SSO_SESSIONS=""                # sso-session names from ~/.aws/config to refresh with `devbox login`
                                      # (one device-code login per session). Empty = no AWS login on the box.
COPY_AWS_CONFIG="yes"                 # copy ~/.aws/config (profiles only; refused if it contains keys)
GCLOUD="off"                          # "on" installs gcloud and adds it to `devbox login`

# --- Repos ------------------------------------------------------------------------
# owner/repo:path-under-home. Same paths as the laptop keep Claude memory and scripts portable.
REPOS=""                              # e.g. "acme/api:Dev/api acme/web:Dev/web"
WIP_ROOTS="Dev"                       # `devbox wip` scans these (and their immediate subdirectories)

# --- Extras -----------------------------------------------------------------------
PROFILE=""                            # path to a project profile dir (see profiles/README.md)
SYNC_CLAUDE_ENV="no"                  # "yes" also copies your ~/.claude/settings.json env block to
                                      # the box. Off by default: env often holds API keys/tokens.
RETIRED_SKILLS=""                     # sync-claude never copies these (space-separated names)
RETIRED_PLUGINS=""                    # e.g. "someplugin@some-marketplace"
RETIRED_HOOKS=""                      # substrings; Mac hooks whose command contains one are not copied
